# Sao chép thành .env rồi chạy: node --env-file=.env server.js (Docker Compose tự đặt các biến này)
PORT=3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Phía API: Redis không trả lời sau thời hạn này (ms) thì trả 503
REDIS_COMMAND_TIMEOUT_MS=5000
UPLOAD_DIR=uploads
OUTPUT_DIR=output
# Giới hạn upload
MAX_FILES=50
MAX_FILE_MB=20
# Vòng đời kết quả: giữ ZIP và trạng thái trong 1 giờ, dọn file quá hạn mỗi 10 phút
RESULT_TTL_SECONDS=3600
SWEEP_INTERVAL_SECONDS=600
# Worker
WORKER_CONCURRENCY=4
CONVERT_TIMEOUT_SECONDS=120
# Bảo mật: CORS_ORIGINS để trống là chỉ cùng origin; nhiều origin thì cách nhau bằng dấu phẩy
CORS_ORIGINS=
# Giới hạn tần suất theo IP: số lần upload trong 15 phút, số request /status và /download trong 1 phút
UPLOAD_RATE_LIMIT=10
API_RATE_LIMIT=120
# Đặt 1 khi chạy sau một reverse proxy, để req.ip là IP thật của client
TRUST_PROXY=
