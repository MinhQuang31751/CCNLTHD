# Sao chép thành .env rồi chạy: node --env-file=.env server.js (Docker Compose tự đặt các biến này)
PORT=3000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
UPLOAD_DIR=uploads
OUTPUT_DIR=output
# Giới hạn upload
MAX_FILES=50
MAX_FILE_MB=20
# Vòng đời kết quả: giữ ZIP và trạng thái trong 1 giờ, dọn file quá hạn mỗi 10 phút
RESULT_TTL_SECONDS=3600
SWEEP_INTERVAL_SECONDS=600
# Worker
WORKER_CONCURRENCY=4
CONVERT_TIMEOUT_SECONDS=120
